# Copy to deploy/.env and replace the placeholders.
WEB_USERNAME=admin
WEB_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_GENERATED_HASH'
# Public URL must be the HTTPS origin used by the browser and MCP client.
PUBLIC_BASE_URL=https://health.example.com
OAUTH_ISSUER_URL=https://health.example.com/mcp
